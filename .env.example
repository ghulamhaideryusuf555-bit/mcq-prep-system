# ============================================================
# FRONTEND (Vite) — safe to expose in the browser bundle.
# Prefix with VITE_ so Vite includes them in the client build.
# Set these in Netlify: Site settings → Environment variables
# ============================================================
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ============================================================
# BACKEND (Netlify Functions) — SECRET. Never prefix with VITE_,
# never referenced from frontend code. Set these in Netlify:
# Site settings → Environment variables → only exposed to Functions.
# ============================================================

# Supabase service role key (bypasses RLS — server-side only, used
# to write confirmed imports and to read/write the API-key Vault).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Optional fallback: if set, used only when no key has been entered
# yet in the in-app Settings page. Leave blank otherwise — admins
# enter and rotate the real key from Settings once deployed. Provider
# keys entered via Settings are encrypted at rest by Supabase Vault
# (pgsodium), not by anything in this file.
ANTHROPIC_API_KEY=
